pro:card a foaf:PersonalProfileDocument; foaf:maker :me; foaf:primaryTopic :me.

:id1730375244291 a soc:TwitterAccount, pr:TwitterAccount; foaf:id "@graceelcock".

:id1730375276859
a soc:InstagramAccount, pr:InstagramAccount; foaf:id "@graceelcock".
:id1730375489344
    a soc:MastodonAccount, pr:MastodonAccount;
    foaf:id "@graceelcockmastodon.social".
:id1736761617942 a soc:LinkedInAccount; foaf:accountName "grace-elcock-177361106".

:me
    a schema:Person, foaf:Person;
    vcard:bday "1995-10-05"^^xsd:date;
    vcard:fn "Grace Elcock";
    vcard:hasPhoto <GE%20photo.jpeg>;
    vcard:organization-name "Office of Sir Tim Berners-Lee";
    vcard:role "Chief of Staff";
    acl:trustedApp
            [
                acl:mode acl:Append, acl:Control, acl:Read, acl:Write;
                acl:origin <https://timbl.com>
            ];
    ldp:inbox inbox:;
    space:preferencesFile </settings/prefs.ttl>;
    space:storage g:;
    solid:account g:;
    solid:oidcIssuer <https://solidcommunity.net/>;
    solid:preferredObjectPronoun "her";
    solid:preferredRelativePronoun "hers";
    solid:preferredSubjectPronoun "she";
    solid:privateTypeIndex </settings/privateTypeIndex.ttl>;
    solid:profileBackgroundColor "#fffcad"^^xsd:color;
    solid:publicTypeIndex </settings/publicTypeIndex.ttl>;
    foaf:account
            ( :id1730375489344 :id1730375244291 :id1730375276859
            :id1736761617942 :id1736761643210 ),
        ( :id1730375244291 :id1730375276859 );
    foaf:knows :me, c1:me;
    foaf:name "Grace Elcock".
