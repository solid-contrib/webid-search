<#id1777391448361> a solid:PastRole;
    vcard:role "Technical Assistant of Sir Tim Berners-Lee";
    schema:description "In a supporting role of Sir Tim Berners-Lee, I was an Engineering Manager of the open source SolidOS project, chaired Solid World, was part of the Solid Team and worked on Solid standards.";
