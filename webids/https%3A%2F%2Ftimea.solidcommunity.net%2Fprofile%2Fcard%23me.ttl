<#id1777443446632> a solid:PastRole;
    vcard:role "Software Engineer";
    schema:description "As a Software Engineer I worked on the PoolParty Semantic Suite in the development team. Main responsibilities were Triplestore Integration (RDF4J, Stardog, AllegroGraph, MarkLogic, Virtuoso, GraphDB, Rya, Neptune) and PoolParty GraphSearch which exposes a faceted search either on a triplestore (SPARQL) or index (solr or elasticsearch).";
    schema:startDate "2018-01-01"^^xsd:date;
    org:member <#me>;
    org:organization <#id1777443446633>;
    schema:endDate "2019-09-01"^^xsd:date.
<#id1777443446633> a vcard:Organization, schema:Corporation;
    schema:name "Semantic Web Company";
    org:location "Vienna".
<#id1777443446634> a solid:PastRole;
    vcard:role "Knowledge Engineer";
    schema:description "As a knowledge engineer at SWC I had the opportunity to work with very interesting and diverse companies some of which are: Asian Development Bank, Columbia Sportswear, XO Group, Australian National Data Services, National Archives of Australia, Climate Technology Centre & Network. Part of the technical consultants team, I advised and created data oriented solutions for clients for Information Management but also Semantic Search, Cognitive Computing and Taxonomy Management and Linked Data solutions in general. Problem solving, knowledge transfer and project management were key skills developed during working at Semantic Web Company.";
    schema:startDate "2015-02-01"^^xsd:date;
    org:member <#me>;
    org:organization <#id1777443446635>;
    schema:endDate "2017-12-01"^^xsd:date.
<#id1777443446635> a vcard:Organization, schema:Corporation;
    schema:name "Semantic Web Company";
    org:location "Vienna".
